# --- Frontend (Vite, all public/non-secret) ---
VITE_ARCH_RPC_URL=https://rpc.testnet.arch.network
VITE_ARCH_INDEXER_URL=https://explorer.arch.network/api/v1/testnet
VITE_SCRAMBLE_ASSET_MINT=1d46e0dd87393236e4e01252439f46dcbaec7c2255d1fd734e61771a00e8f4e9
# Set after deploy:
VITE_SCRAMBLE_PROGRAM_ID=
# Realtime server (wss:// in production):
VITE_GAME_WS_URL=ws://127.0.0.1:8890

# --- Realtime server (server/, SECRET stays here) ---
# PORT=8890
# HOST=0.0.0.0
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# ARCH_RPC_URL=https://rpc.testnet.arch.network
# SCRAMBLE_PROGRAM_ID=            # enables on-chain create/settle
# SCRAMBLE_ASSET_MINT=1d46e0dd87393236e4e01252439f46dcbaec7c2255d1fd734e61771a00e8f4e9
# SERVER_SIGNING_PRIVATE_KEY=     # 64-hex; the settlement attestation key (SECRET)
# or SERVER_SIGNING_KEY_FILE=/path/to/key.json
# GAME_DEV_FREEJOIN=1             # local dev only: skip on-chain entry
