{
  "name": "hashplay-satoshi-scramble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit ",
    "test": "tsx --test tests/*.test.ts",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npm run dev:server & npm run dev",
    "testnet:preflight": "server/node_modules/.bin/tsx scripts/preflight.mts",
    "testnet:deploy": "bash scripts/deploy-and-init.sh",
    "testnet:e2e": "server/node_modules/.bin/tsx scripts/testnet-e2e.mts",
    "test:all": "npm test && npx tsx --test tests/multiplayer.test.mts tests/scaling.test.mts",
    "testnet:init": "server/node_modules/.bin/tsx scripts/init-config.mts"
  },
  "dependencies": {
    "@arch-network/arch-sdk": "0.0.28",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/btc-signer": "^2.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.21.3"
  }
}
