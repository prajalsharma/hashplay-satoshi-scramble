{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "../src/shared/**/*.ts", "../src/arch/**/*.ts"]
}
